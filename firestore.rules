rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLECTION RULES ---

    // 1. Queues Collection (Main Queue System)
    match /queues/{docId} {
      // DEVELOPMENT: Allow all to support Admin Dashboard Bypass
      allow read, write: if true;
      
      // PRODUCTION (Recommended):
      // allow read: if true; // Patients need to see their status
      // allow write: if isSignedIn(); // Only authenticated staff or patients should modify
    }

    // 2. Doctor Rooms (Room Management)
    match /doctor_rooms/{docId} {
      // DEVELOPMENT: Allow all
      allow read, write: if true;
      
      // PRODUCTION:
      // allow read: if true;
      // allow write: if isSignedIn();
    }

    // 3. Admin Actions (Audit Trail)
    match /admin_actions/{docId} {
      allow read, write: if true; // Change to isSignedIn() for production
    }

    // 4. SMS Logs & Notifications
    match /sms_logs/{docId} {
      allow read, write: if true; // Change to isSignedIn() for production
    }

    match /emergency_broadcasts/{docId} {
      allow read, write: if true;
    }

    // 5. Existing App Features
    match /healthTips/{tipId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /userHabits/{docId} {
      allow read, create, update, delete: if isSignedIn() && docId.matches('^' + request.auth.uid + '_.*$');
    }

    match /appointments/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /vitals/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /prescriptions/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (request.auth.token.email != null && request.auth.token.email == uid)
      );
      allow write: if false;
    }

    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
